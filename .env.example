# =============================================================================
# invoice-engine — variables de entorno
# =============================================================================
# Copia este archivo a .env y completa los valores antes de arrancar.
#
#   cp .env.example .env
#
# Las variables marcadas con (*) son obligatorias para el funcionamiento básico.
# =============================================================================


# ─── Docker / Puertos expuestos en el host ────────────────────────────────────

# Puerto en el que el frontend estará disponible en tu máquina local.
FRONTEND_PORT=3000

# Puerto en el que el backend estará disponible en tu máquina local.
BACKEND_PORT=5000


# ─── Frontend (Next.js) ───────────────────────────────────────────────────────

# (*) URL base del backend que el navegador usará para hacer peticiones.
# En desarrollo local apunta a localhost; en producción a tu dominio real.
# IMPORTANTE: esta variable se hornea en el bundle durante `next build`,
# por lo que un cambio requiere reconstruir la imagen del frontend.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1


# ─── Backend — Aplicación (NestJS) ────────────────────────────────────────────

# (*) Puerto en el que escucha el servidor NestJS dentro del contenedor.
# Debe coincidir con BACKEND_PORT si no hay un proxy entre ambos.
PORT=5000

# Entorno de ejecución. Valores típicos: development | production | test
ENV=development

# Nombre descriptivo de la aplicación (usado en logs, etc.).
APP_NAME=invoice-engine-api


# ─── Backend — CORS ───────────────────────────────────────────────────────────

# (*) Orígenes permitidos para peticiones cross-origin, separados por coma.
# Incluir la URL del frontend para que el navegador no bloquee las llamadas.
ALLOWED_ORIGINS=http://localhost:3000

# Métodos HTTP habilitados en CORS.
METHODS=GET,HEAD,PUT,PATCH,POST,DELETE


# ─── Backend — Autenticación ──────────────────────────────────────────────────

# Clave secreta para firmar y verificar tokens JWT.
# Usar una cadena aleatoria larga (mín. 32 caracteres).
JWT_SECRET=change_me_use_a_long_random_string_here

# Emisor del token JWT (claim "iss"). Identifica quién emite el token.
JWT_ISSUER=invoice-engine

# Audiencia del token JWT (claim "aud"). Identifica a quién va dirigido.
JWT_AUDIENCE=invoice-engine-client

# Clave de API estática para proteger endpoints internos (opcional).
API_KEY=change_me_api_key


# ─── Backend — AWS S3 (almacenamiento de PDFs) ────────────────────────────────

# ID de la clave de acceso de tu usuario IAM de AWS.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE

# Clave de acceso secreta correspondiente al ID anterior.
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# Región de AWS donde está el bucket S3.
AWS_REGION=us-east-1

# Nombre del bucket S3 donde se almacenarán los PDFs generados.
AWS_S3_BUCKET=my-invoice-bucket

# Versión del algoritmo de firma de S3. Usar siempre v4.
AWS_S3_VERSION=v4
